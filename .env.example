# One Compose project name per deployment; keep it stable to retain named volumes.
COMPOSE_PROJECT_NAME=potsandplanters
HTTP_BIND=127.0.0.1
HTTP_PORT=8080
APP_NAME="Pots & Planters"
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:8080
# Generate using the Docker command in README. Never rotate on redeployment.
APP_KEY=
DB_CONNECTION=mariadb
DB_HOST=db
DB_PORT=3306
DB_DATABASE=potsandplanters
DB_USERNAME=potsandplanters
# Set unique values before startup; deliberately no default credentials.
DB_PASSWORD=
DB_ROOT_PASSWORD=
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_CLIENT=phpredis
REDIS_DB=0
REDIS_CACHE_DB=1
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_CONNECTION=default
SESSION_COOKIE=potsandplanters_session
SESSION_DOMAIN=null
SESSION_PATH=/
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
LOG_CHANNEL=stderr
LOG_LEVEL=info
# PHP-FPM is internal, reached only through nginx. See Dokploy trust boundary.
TRUSTED_PROXIES=*
# Server-only URL; never use a NEXT_PUBLIC_ variable for Docker service addresses.
API_INTERNAL_URL=http://nginx/api
