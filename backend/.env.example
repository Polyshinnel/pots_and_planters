# Docker injects configuration from the root .env via compose.yaml.
# Do not create a backend/.env for the documented Docker workflow.
APP_NAME="Pots & Planters"
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=http://localhost:8080
DB_CONNECTION=mariadb
DB_HOST=db
DB_PORT=3306
DB_DATABASE=potsandplanters
DB_USERNAME=potsandplanters
DB_PASSWORD=
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_CONNECTION=default
SESSION_SECURE_COOKIE=false
LOG_CHANNEL=stderr
