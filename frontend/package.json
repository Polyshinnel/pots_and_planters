{
  "name": "potsandplanters-frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "node .next/standalone/server.js",
    "typecheck": "tsc --noEmit",
    "test:catalog": "node tests/catalog.test.cjs",
    "test:product": "node tests/product-detail.test.cjs",
    "test:enquiry": "node tests/enquiry.test.cjs && node --test tests/enquiry-store-v2.test.cjs",
    "test:forms": "node --test tests/forms.test.cjs tests/enquiry-api.test.cjs",
    "test:contacts": "node tests/contacts.test.cjs",
    "test:product-api": "node --test tests/product-api.test.cjs",
    "test:solutions-enquiry": "node --test tests/solutions-enquiry-guard.test.cjs",
    "test:product-actions-guard": "node --test tests/product-actions-guard.test.cjs"
  },
  "dependencies": {
    "@fancyapps/ui": "^6.1.15",
    "@mantine/core": "9.4.2",
    "@mantine/hooks": "9.4.2",
    "@tabler/icons-react": "^3.49.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "swiper": "^14.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "5.9.3"
  }
}
